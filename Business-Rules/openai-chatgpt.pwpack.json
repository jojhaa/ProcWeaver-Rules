        "role": "main",
        "description": "桌面主客户端"
      },
      {
        "exe": "codex.exe",
        "role": "worker",
        "description": "OpenAI 核心数据与代码辅助进程"
      },
      {
        "exe": "node.exe",
        "role": "worker",
        "description": "扩展脚本与本地运行依赖"
      }
    ],
    "additionalExes": [
      "ChatGPT.exe",
      "codex.exe",
      "node.exe"
    ],
    "domains": [
